  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  X-ORIGIN 'veldrane' )

attributeTypes: ( 1.3.6.1.4.1.64115.1.2
  NAME 'labOwner'
  DESC 'Responsible person or team'
  EQUALITY caseIgnoreMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  SINGLE-VALUE
  X-ORIGIN 'veldrane' )

attributeTypes: ( 1.3.6.1.4.1.64115.1.3
  NAME 'labLocation'
  DESC 'Physical location of host'
  EQUALITY caseIgnoreMatch
