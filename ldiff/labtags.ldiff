  SINGLE-VALUE
  X-ORIGIN 'veldrane' )

objectClasses: ( 1.3.6.1.4.1.64115.2.1
  NAME 'labHostExtension'
  DESC 'Auxiliary class for extended host attributes'
  SUP top
  AUXILIARY
